# ==============================================================================
# 🔐 CONFIGURAÇÕES DE AMBIENTE DA ESTEIRA SDD (Spec-Driven Development Flow)
# ==============================================================================
# IMPORTANTE: Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env no Git/GitHub.
# ==============================================================================

# 🐙 1. INTEGRAÇÃO COM GITHUB (Issues, PRs, CI/CD)
# Token pessoal clássico com permissão para repo, issues e workflows
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_seuTokenPessoalAqui
GITHUB_OWNER=seu_usuario_github

# 🖥️ 2. INFRAESTRUTURA HOSTINGER VPS (Execução 24/7 e Deploy)
HOSTINGER_SSH_HOST=seu_ip_vps_aqui
HOSTINGER_SSH_USER=root
HOSTINGER_SSH_PORT=22
HOSTINGER_PROJECT_BASE_DIR=/opt

# 💬 3. BOT WHATSAPP & EVOLUTION API v2 (Baileys Engine)
# URL interna (se rodando no mesmo host) ou IP público da VPS
EVOLUTION_API_URL=http://localhost:8082
EVOLUTION_API_KEY=sua_chave_global_evolution_api
EVOLUTION_INSTANCE=sdd-agent

# Número emissor do robô (com DDI e DDD sem traços ou espaços)
WHATSAPP_BOT_NUMBER=5561999999999

# 🛡️ GUARDRAIL DE SEGURANÇA ESTRITA: O robô só responderá a este número mestre!
# Qualquer outra mensagem recebida será silenciosamente ignorada e descartada.
WHATSAPP_MASTER_ADMIN=5562999999999

# Porta do servidor Webhook para escuta dos comandos (/sdd status, /sdd run, etc.)
WHATSAPP_WEBHOOK_PORT=8088

# 🧠 4. MOTOR AUTÔNOMO DE IA (Google Gemini SDK)
GEMINI_API_KEY=sua_chave_google_gemini_api
GEMINI_MODEL=gemini-2.5-flash
MAX_TDD_RETRIES=3
